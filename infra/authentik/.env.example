# Скопируйте в `.env` в этой же папке и заполните секреты.
# Документация: https://docs.goauthentik.io/install-config/install/docker-compose/

# Обязательные значения (compose подставит их в сервисы)
PG_PASS=
AUTHENTIK_SECRET_KEY=

# Опционально: порты HTTP/HTTPS на хосте (по умолчанию 9000 / 9443)
# COMPOSE_PORT_HTTP=9000
# COMPOSE_PORT_HTTPS=9443

# Опционально: БД и пользователь PostgreSQL
# PG_DB=authentik
# PG_USER=authentik

# Опционально: образ и тег (по умолчанию как в официальном compose)
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
# AUTHENTIK_TAG=2026.2.2
